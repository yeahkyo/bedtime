# Local Docker Compose defaults. Staging host: copy .env.staging.example instead.
# See docs/deploy-staging.md
ENV=dev
# Local convenience: anonymous Dev Parent. Never enable on a public hostname.
DEV_AUTH_BYPASS=1
# Local Swagger. Staging/public: set EXPOSE_API_DOCS=0 (or ENV≠dev).
EXPOSE_API_DOCS=1
MOCK_PROVIDERS=0
# Compat preset: fish (doubao+fishaudio) | volc | openai | deepseek
PROVIDER_PROFILE=fish
# Optional overrides (empty = derive from PROVIDER_PROFILE)
# STORY_PROVIDER: doubao | openai | deepseek | mock
# SPEECH_PROVIDER: fishaudio | volc | elevenlabs | aliyun | mock
STORY_PROVIDER=
SPEECH_PROVIDER=
# Optional: 1 = LLM text only (no TTS). Default off.
STORY_SKIP_TTS=0
# local = apps/api/.data + anonymous /media (dev only). Staging/prod: s3 (R2).
STORAGE_BACKEND=local

DATABASE_URL=mysql+asyncmy://bedtime:bedtime@127.0.0.1:3307/bedtime
REDIS_URL=redis://127.0.0.1:6380/0

JWT_SECRET=dev-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30
# Non-dev: comma-separated browser origins (required for credentialed CORS).
# Include https://huhu.lullvale.com for landing waitlist form.
CORS_ORIGINS=
# Non-dev: required at startup + for POST /v1/account/retention/run (X-Retention-Admin-Token).
RETENTION_ADMIN_TOKEN=

# Admin UI bootstrap (Bandage-style). Required when ENV≠dev.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=local-dev-admin
ADMIN_JWT_EXPIRE_HOURS=12

# Local MinIO (compose --profile minio). R2 example: see .env.staging.example
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=bedtime
S3_REGION=auto
S3_PUBLIC_BASE_URL=

# 豆包 Ark（故事）— 需在控制台开通「在线推理」接入点，ARK_MODEL 填接入点 ID 或模型名
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-1.6-250615

# Fish Audio（默认 TTS/克隆；火山语音槽位暂停时用此栈）
FISH_AUDIO_API_KEY=
FISH_AUDIO_DEFAULT_VOICE_ID=
FISH_AUDIO_TTS_MODEL=s2-pro
FISH_AUDIO_BASE_URL=https://api.fish.audio

# 阿里云百炼 CosyVoice（SPEECH_PROVIDER=aliyun）
# API Key：控制台「API-KEY」；Workspace ID：业务空间专属域名所需
ALIYUN_DASHSCOPE_API_KEY=
# 或沿用官方环境变量名：
# DASHSCOPE_API_KEY=
ALIYUN_TTS_WORKSPACE_ID=
ALIYUN_TTS_REGION=cn-beijing
ALIYUN_TTS_MODEL=cosyvoice-v3-flash
ALIYUN_TTS_DEFAULT_VOICE=longanyang
# 可选：覆盖 api/v1 根或完整 SpeechSynthesizer URL
# ALIYUN_TTS_BASE_URL=

# 豆包语音（TTS/克隆）— 槽位恢复后可 SPEECH_PROVIDER=volc 再用
VOLC_SPEECH_API_KEY=
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_ICL_RESOURCE_ID=seed-icl-2.0
# Set 1 only if your TTS resource supports SSML <break>/<prosody> (not seed-tts-2.0 / ICL).
VOLC_TTS_ENABLE_SSML=0
VOLC_DEFAULT_SPEAKER=zh_female_vv_uranus_bigtts

# DeepSeek（故事 LLM；OpenAI 兼容）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 备用国际栈（PROVIDER_PROFILE=openai 或 STORY_PROVIDER=openai / SPEECH_PROVIDER=elevenlabs）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

STORY_RETENTION_MONTHS=24
RAW_VOICE_RETENTION_HOURS=24
ANALYTICS_RETENTION_DAYS=180
MONTHLY_STORY_QUOTA=15
MONTHLY_CLONE_QUOTA=3
