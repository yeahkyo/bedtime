# LOCAL secrets file (gitignored). Copy once:
#   cp apps/api/.env.staging.example apps/api/.env.staging
# Fill values on your laptop, then:
#   ./deploy.sh          # scp → server apps/api/.env + compose
# Do not commit .env.staging. See docs/deploy-staging.md.
#
# Internal App testing: ENV=dev + DEV_AUTH_BYPASS (dev-login). Lock down who can
# reach the Cloudflare hostname. Before public prod: Apple JWKS (not implemented).

ENV=dev
DEV_AUTH_BYPASS=1
MOCK_PROVIDERS=0
PROVIDER_PROFILE=fish
STORY_PROVIDER=
SPEECH_PROVIDER=

# Compose staging overrides these to service hostnames; keep for documentation.
DATABASE_URL=mysql+asyncmy://bedtime:CHANGE_ME_DB_PASSWORD@mariadb:3306/bedtime
REDIS_URL=redis://redis:6379/0
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD

# Required before ENV≠dev; set a strong value now anyway.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30

# Native App does not need CORS; set if you add a web admin later.
CORS_ORIGINS=

# Used by apps/api/scripts/run_retention.sh (and required when ENV≠dev).
RETENTION_ADMIN_TOKEN=CHANGE_ME_RETENTION_ADMIN_TOKEN

# Admin UI (apps/admin) bootstrap — required when ENV≠dev.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_JWT_EXPIRE_HOURS=12

# Cloudflare R2 (S3-compatible) — required for staging compose
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=bedtime
S3_REGION=auto
S3_PUBLIC_BASE_URL=

ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-1.6-250615

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

FISH_AUDIO_API_KEY=
FISH_AUDIO_DEFAULT_VOICE_ID=
FISH_AUDIO_TTS_MODEL=s2-pro
FISH_AUDIO_BASE_URL=https://api.fish.audio

# Aliyun CosyVoice (SPEECH_PROVIDER=aliyun)
ALIYUN_DASHSCOPE_API_KEY=
ALIYUN_TTS_WORKSPACE_ID=
ALIYUN_TTS_REGION=cn-beijing
ALIYUN_TTS_MODEL=cosyvoice-v3-flash
ALIYUN_TTS_DEFAULT_VOICE=longanyang

VOLC_SPEECH_API_KEY=
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_ICL_RESOURCE_ID=seed-icl-2.0
VOLC_TTS_ENABLE_SSML=0
VOLC_DEFAULT_SPEAKER=zh_female_vv_uranus_bigtts

STORY_RETENTION_MONTHS=24
RAW_VOICE_RETENTION_HOURS=24
MONTHLY_STORY_QUOTA=30
MONTHLY_CLONE_QUOTA=3

# Public HTTPS URL via Cloudflare (App). Trailing slash optional.
PUBLIC_API_BASE_URL=https://bedtime-api.lullvale.com

# Host port published by docker-compose.staging.yml (Bandage already uses 80).
# Cloudflare Origin Rule must send this hostname to the same port.
API_HOST_PORT=8080
# Bedtime admin UI (compose --profile admin); avoid Bandage :8081
ADMIN_UI_PORT=8083
ADMIN_UI_API_BASE=
